# Demo login (dev only). Set ENABLE_DEMO_LOGIN=false in production.
ENABLE_DEMO_LOGIN=true
# MongoDB ObjectId of the shared demo tenant (run: node database/mongo/seed-demo-tenant.js)
DEMO_TENANT_ID=

# Active gateway: stripe (default) | razorpay (India — enable later)
BILLING_PROVIDER=stripe

# Stripe (current)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (India — kept for later; unused while BILLING_PROVIDER=stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Platform seller details for GST tax invoices
BILLING_SELLER_LEGAL_NAME=DSA Smart
BILLING_SELLER_GSTIN=
BILLING_SELLER_PAN=
BILLING_SELLER_EMAIL=
BILLING_SELLER_PHONE=
BILLING_SELLER_ADDRESS_LINE1=
BILLING_SELLER_ADDRESS_LINE2=
BILLING_SELLER_CITY=Mumbai
BILLING_SELLER_STATE=Maharashtra
BILLING_SELLER_STATE_CODE=27
BILLING_SELLER_PINCODE=400001
BILLING_SELLER_COUNTRY=IN
BILLING_SAC=998314
BILLING_GST_RATE_BPS=1800
BILLING_INVOICE_PREFIX=DSA
BILLING_LOGO_URL=
